<PlanAccordion>:
    rows: 2
    md_bg_color: get_color_from_hex(MeileColors.DIALOG_BG_COLOR2)
    radius: [5, 5, 5, 5]
    size_hint_y: None
    height: self.minimum_height
    
    
#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import sp kivy.metrics.sp
#:import dp kivy.metrics.dp

<NodeCarousel>:
    name: "node_carousel"
    orientation: "vertical"
    spacing: dp(10)
    padding: dp(14)

    # ===== HEADER =====
    MDBoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: dp(80)
        spacing: dp(4)

        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(44)

            MDLabel:
                text: root.moniker
                theme_text_color: "Custom"
                text_color: get_color_from_hex(MeileColors.MEILE)
                font_size: sp(24)
                font_name: root.get_font()
                shorten: True
                shorten_from: "right"

            AnchorLayout:
                anchor_x: "right"
                anchor_y: "center"
                size_hint_x: None
                width: dp(48)
                TooltipMDIconButton:
                    icon: "server-network"
                    tooltip_text: "Nodes"
                    theme_text_color: "Custom"
                    text_color: get_color_from_hex(MeileColors.MEILE)
                    on_press:
                        self.on_leave()
                        root.switch_carousel()

        HSeparator:
            size_hint_y: None
            height: dp(1)

        MDLabel:
            text: root.address
            font_size: sp(11)
            size_hint_y: None
            height: dp(20)
            theme_text_color: "Custom"
            text_color: 0.7, 0.7, 0.7, 1

    # ===== BODY: LEFT (cards) | RIGHT (map + actions) =====
    MDBoxLayout:
        orientation: "horizontal"
        spacing: dp(14)

        # ========== LEFT COLUMN ==========
        MDBoxLayout:
            orientation: "vertical"
            size_hint_x: 0.58
            spacing: dp(10)

            # ----- PRICING -----
            MDCard:
                orientation: "vertical"
                padding: dp(12)
                radius: [dp(16)]
                elevation: 0
                md_bg_color: 0.10, 0.10, 0.12, 1
                line_color: root.themed_border(0.35)
                size_hint_y: None
                height: dp(120)

                MDLabel:
                    text: "PRICING"
                    bold: True
                    halign: "center"
                    size_hint_y: None
                    height: dp(22)
                    theme_text_color: "Custom"
                    text_color: get_color_from_hex(MeileColors.MEILE)
                    font_size: sp(13)

                MDGridLayout:
                    cols: 2
                    spacing: dp(8)

                    MDLabel:
                        text: "Per GB"
                        halign: "center"
                        font_size: sp(11)
                        theme_text_color: "Custom"
                        text_color: 0.65, 0.65, 0.65, 1
                        size_hint_y: None
                        height: dp(18)
                    MDLabel:
                        text: "Per Hour"
                        halign: "center"
                        font_size: sp(11)
                        theme_text_color: "Custom"
                        text_color: 0.65, 0.65, 0.65, 1
                        size_hint_y: None
                        height: dp(18)

                    MDLabel:
                        text: root.gb_prices
                        halign: "center"
                        valign: "top"
                        font_size: sp(12)
                    MDLabel:
                        text: root.hr_prices
                        halign: "center"
                        valign: "top"
                        font_size: sp(12)

            # ----- BANDWIDTH -----
            MDCard:
                orientation: "vertical"
                padding: dp(12)
                radius: [dp(16)]
                elevation: 0
                md_bg_color: 0.10, 0.10, 0.12, 1
                line_color: root.themed_border(0.35)
                spacing: dp(4)
                size_hint_y: None
                height: dp(130)

                MDLabel:
                    text: "BANDWIDTH"
                    bold: True
                    halign: "center"
                    size_hint_y: None
                    height: dp(22)
                    theme_text_color: "Custom"
                    text_color: get_color_from_hex(MeileColors.MEILE)
                    font_size: sp(13)

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(18)
                    MDLabel:
                        text: "Download"
                        font_size: sp(11)
                        theme_text_color: "Custom"
                        text_color: 0.65, 0.65, 0.65, 1
                    MDLabel:
                        text: root.download
                        font_size: sp(11)
                        halign: "right"

                MDProgressBar:
                    id: dl_bar
                    #value: root.download_norm * 100
                    value: 0
                    color: get_color_from_hex(MeileColors.DOWNLOAD)
                    size_hint_y: None
                    height: dp(6)

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(18)
                    MDLabel:
                        text: "Upload"
                        font_size: sp(11)
                        theme_text_color: "Custom"
                        text_color: 0.65, 0.65, 0.65, 1
                    MDLabel:
                        text: root.upload
                        font_size: sp(11)
                        halign: "right"

                MDProgressBar:
                    id: ul_bar
                    #value: root.upload_norm * 100
                    value: 0
                    color: get_color_from_hex(MeileColors.UPLOAD)
                    size_hint_y: None
                    height: dp(6)

            # ----- NETWORK -----
            MDCard:
                orientation: "vertical"
                padding: dp(12)
                radius: [dp(16)]
                elevation: 0
                md_bg_color: 0.10, 0.10, 0.12, 1
                line_color: root.themed_border(0.35)
                size_hint_y: None
                height: dp(150)

                MDLabel:
                    text: "NETWORK"
                    bold: True
                    halign: "center"
                    size_hint_y: None
                    height: dp(22)
                    theme_text_color: "Custom"
                    text_color: get_color_from_hex(MeileColors.MEILE)
                    font_size: sp(13)

                MDGridLayout:
                    cols: 2
                    spacing: dp(4)

                    MDLabel:
                        text: "Peers"
                        font_size: sp(12)
                        theme_text_color: "Custom"
                        text_color: 0.65, 0.65, 0.65, 1
                    MDLabel:
                        text: root.connected_peers + " / " + root.max_peers
                        font_size: sp(12)
                        halign: "right"

                    MDLabel:
                        text: "Protocol"
                        font_size: sp(12)
                        theme_text_color: "Custom"
                        text_color: 0.65, 0.65, 0.65, 1
                    MDLabel:
                        text: root.protocol + " " + root.version
                        font_size: sp(12)
                        halign: "right"

                    MDLabel:
                        text: "Handshake"
                        font_size: sp(12)
                        theme_text_color: "Custom"
                        text_color: 0.65, 0.65, 0.65, 1
                    MDLabel:
                        text: root.handshake
                        font_size: sp(12)
                        halign: "right"

                    MDLabel:
                        text: "Health"
                        font_size: sp(12)
                        theme_text_color: "Custom"
                        text_color: 0.65, 0.65, 0.65, 1
                    MDLabel:
                        text: root.health_check
                        font_size: sp(12)
                        halign: "right"
                        theme_text_color: "Custom"
                        text_color:
                            (0.3, 0.9, 0.4, 1) if root.health_check == "Passed" \
                            else ((1, 0.85, 0.2, 1) if root.health_check == "Checking..." \
                            else (1, 0.35, 0.35, 1))

            # ----- REPUTATION -----
            MDCard:
                orientation: "vertical"
                padding: dp(12)
                radius: [dp(16)]
                elevation: 0
                md_bg_color: 0.10, 0.10, 0.12, 1
                line_color: root.themed_border(0.35)
                spacing: dp(4)
                size_hint_y: None
                height: dp(120)

                MDLabel:
                    text: "REPUTATION"
                    bold: True
                    halign: "center"
                    size_hint_y: None
                    height: dp(22)
                    theme_text_color: "Custom"
                    text_color: get_color_from_hex(MeileColors.MEILE)
                    font_size: sp(13)

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(22)

                    MDLabel:
                        text: "Score"
                        font_size: sp(12)
                        theme_text_color: "Custom"
                        text_color: 0.65, 0.65, 0.65, 1
                    MDLabel:
                        text: str(root.score)
                        font_size: sp(12)
                        halign: "right"
                        theme_text_color: "Custom"
                        text_color:
                            (0.3, 0.9, 0.4, 1) if float(root.score) > 80 \
                            else (1, 0.65, 0.2, 1)

                MDProgressBar:
                	id: score_bar
                    #value: float(root.score)
                    value: 0
                    color: get_color_from_hex(MeileColors.MEILE)
                    size_hint_y: None
                    height: dp(6)

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(22)

                    MDLabel:
                        text: "Votes"
                        font_size: sp(12)
                        theme_text_color: "Custom"
                        text_color: 0.65, 0.65, 0.65, 1
                    MDLabel:
                        text: root.votes
                        font_size: sp(12)
                        halign: "right"

            # ----- META -----
            MDCard:
                orientation: "vertical"
                padding: dp(12)
                radius: [dp(16)]
                elevation: 0
                md_bg_color: 0.10, 0.10, 0.12, 1
                line_color: root.themed_border(0.35)
                size_hint_y: None
                height: dp(80)

                MDGridLayout:
                    cols: 2
                    spacing: dp(4)

                    MDLabel:
                        text: "ISP"
                        font_size: sp(12)
                        theme_text_color: "Custom"
                        text_color: 0.65, 0.65, 0.65, 1
                    MDLabel:
                        text: root.isp_type
                        font_size: sp(12)
                        halign: "right"

                    MDLabel:
                        text: "Formula"
                        font_size: sp(12)
                        theme_text_color: "Custom"
                        text_color: 0.65, 0.65, 0.65, 1
                    MDLabel:
                        text: root.node_formula
                        font_size: sp(12)
                        halign: "right"

            Widget:

        # ========== RIGHT COLUMN ==========
        MDBoxLayout:
            orientation: "vertical"
            size_hint_x: 0.42
            spacing: dp(12)

            # ----- MAP -----
            MDCard:
                radius: [dp(16)]
                elevation: 0
                md_bg_color: 0.10, 0.10, 0.12, 1
                line_color: root.themed_border(0.35)
                padding: dp(4)
                size_hint_y: 0.7

                RelativeLayout:
                    MapView:
                        id: mapview
                        lat: 48.849943
                        lon: 2.279793
                        zoom: 8

                    MDCard:
                        size_hint: None, None
                        size: dp(220), dp(36)
                        pos_hint: {"center_x": 0.5, "y": 0.03}
                        radius: [dp(18)]
                        md_bg_color: 0, 0, 0, 0.75
                        line_color: root.themed_border(0.5)
                        elevation: 0

                        MDLabel:
                            text: root.location
                            halign: "center"
                            markup: True
                            font_size: sp(12)
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

            # ----- ACTION BUTTONS -----
            MDBoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: dp(48)
                spacing: dp(12)

                MDFlatButton:
                    #text: "Subscribe"
                    size_hint_x: 0.5
                    md_bg_color: get_color_from_hex(MeileColors.DIALOG_BG_COLOR)
                    #theme_text_color: "Custom"
                    #text_color: 0, 0, 0, 1
                    on_release: root.subscribe_to_node(root.gb_prices, root.hr_prices, root.address, root.moniker)
					Image:
	                    id: subscribe_button
	                    size_hint: 2.2,2.2
	                    source: root.get_button("subscribe")
                MDFlatButton:
                    #text: "Live Data"
                    size_hint_x: 0.5
                    md_bg_color: get_color_from_hex(MeileColors.DIALOG_BG_COLOR)
                    #theme_text_color: "Custom"
                    #text_color: 0, 0, 0, 1
                    on_release: root.get_realtime_of_node(root.address)
                    Image:
	                    id: realtime_button
	                    size_hint: 2.2,2.2
	                    source: root.get_button("info")

            Widget:
                size_hint_y: None
                height: dp(8)
                        
<Separator@Widget>:
    canvas:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
<HSeparator@Separator>:
    size_hint_y: None
    height: sp(2)
    
<RowContainer@MDBoxLayout>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    padding: '5sp'  # Adjust the padding as needed
    MDBoxLayout:
        size_hint_y: None
        height: '50sp'
        WalletCoinRow:
            logo: root.logo
            text: root.text
    
<WalletCoinRow>:
    border_radius: 50
    radius: [30]
    md_bg_color: get_color_from_hex("#000000")
    orientation: 'horizontal'
    size_hint_y: None
    height: '50sp'

    Image:
        source: root.logo
        size_hint_x: None
        width: '50sp'

    MDLabel:
        text: root.text
        valign: 'middle'
        halign: 'center'
        text_size: self.size
        theme_text_color: "Custom"
        text_color: get_color_from_hex(MeileColors.MEILE)
        
<RecycleViewRow>:
    size_hint_y: None
    #size: "180sp", "180sp"
    size: "180sp", "25sp"
    pos_hint: {"center_x": .5, "center_y": .5}
    orientation: "vertical"
    #padding: 10,10
    border_radius: 20
    radius: [10]
    md_bg_color: get_color_from_hex("#121212")
    moniker_text: "."
    country_text: "."
    price_text: "."
    hourly_price_text: "."
    address_text: "."
    protocol_text: "."
    isp_type_text: " "
    city_text: " "
    source_image: " "
    speed_image: " "
    speed_text: " "
    node_score: " "
    votes: " "
    city: " "
    icon: ""
    tooltip: ""
    healthcheck: ""
    healthchecktooltip: ""
    node_data: ""
    node_types: ""
    node_scores: ""
    ripple_behavior: True
    #on_press: root.subscribe_to_node(root.price_text, root.hourly_price_text, root.address_text, root.moniker_text)
    on_press: root.switch_to_node_carousel(root.node_data)
    MDGridLayout:
        cols: 5
        
        MDLabel:
            text: root.moniker_text
            theme_text_color: "Custom"
            font_style: "H6"
            font_size: "16sp"
            font_name: root.get_font()
            text_color: get_color_from_hex(MeileColors.MEILE)
            size_hint_x: 2
        MDLabel:    
            text: root.country_text
            theme_text_color: "Custom"
            font_style: "H6"
            font_size: "12sp"
            text_color: (1,1,1,1)  
            size_hint_x: 1
        MDLabel:
            text: root.speed_text
            theme_text_color: "Custom"
            markup: True
            font_name: root.get_font()
            font_size: "12sp"
            text_color: 1,1,1,1
            size_hint_x: 2
        MDLabel:
            text: root.protocol_text
            theme_text_color: "Custom"
            font_style: "Subtitle2"
            font_size: "12sp"
            text_color: get_color_from_hex("#ffffff")
            size_hint_x: 1
        MDLabel:
            text: root.isp_type_text
            theme_text_color: "Custom"
            font_style: "Subtitle2"
            font_size: "12sp"
            text_color: get_color_from_hex("#ffffff")
            size_hint_x: 1

<OnHoverMDRaisedButton>:
                   
<ClickableTextFieldRoundSeed>:
    size_hint_y: None
    height: seed_phrase.height

    MDTextField:
        id: seed_phrase
        multiline: True
        hint_text: root.hint_text
        text: root.text
        password: True
        icon_left: "key-variant"
        mode: "rectangle"

    MDIconButton:
        icon: "eye-off"
        pos_hint: {"center_y": .5}
        pos: seed_phrase.width - self.width + sp(8), 0
        theme_text_color: "Hint"
        on_release:
            self.icon = "eye" if self.icon == "eye-off" else "eye-off"
            seed_phrase.password = False if seed_phrase.password is True else True


