                    font_size: sp(12)
                TooltipMDIconButton:
                    size_hint: None, 1
                    icon: "help-circle"
                    tooltip_text: "Pay an invoice in BTC, BTC ⚡, XMR, LTC, LTC (MWEB), ZEC (shielded), DASH, or DOGE"

            MDBoxLayout:
                orientation: "horizontal"
                Check:
                    size_hint: None, 1
                    on_active: root.on_checkbox_active("now", *args)
                MDLabel:
                    text: "NOWPayments"
                    size_hint: None, 1
                    width: sp(110)
                    font_size: sp(12)
                TooltipMDIconButton:
                    size_hint: None, 1
                    icon: "help-circle"
                    tooltip_text: "Pay using SOL,ADA,BCH,USDT,USDC & more with NOWPayments."
            MDBoxLayout:
                orientation: "horizontal"
                Check:
                    size_hint: None, 1
                    on_active: root.on_checkbox_active("pirate", *args)
                MDLabel:
                    text: "Privacy Coins"
                    size_hint: None, 1
                    width: sp(110)
                    font_size: sp(12)
