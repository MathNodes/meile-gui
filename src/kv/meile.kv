        cols:1
        default_size: sp(200), sp(50)
        default_size_hint: 1, None
        size_hint_y: None
        height: self.minimum_height
        orientation: 'lr-tb' 
        spacing: 5
        padding: 1,1,1,1
        
<NodeRVSub>: 
